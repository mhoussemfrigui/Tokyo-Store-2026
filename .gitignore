# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
# pnpm content-addressable store (only leaks here when running the Dockerized
# dev stack; the compose now routes it into a volume — see docker-compose.claude-dev.yml)
.pnpm-store/
# pnpm-only repo (packageManager + Dockerfile use pnpm-lock.yaml); a stray npm
# lockfile would resolve deps without pnpm.overrides (e.g. the dompurify floor)
package-lock.json

# scratch / working audit dirs (Claude Code)
.tmp/

# next.js
.next/
out/
build/
dist/

# production
*.tsbuildinfo
next-env.d.ts

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# local-only docker override (host port bindings for `docker compose up` tests)
docker-compose.override.yml

# vercel
.vercel

# IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# os
Thumbs.db
