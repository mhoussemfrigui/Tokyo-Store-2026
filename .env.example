# =============================================================================
# Tokyo Store — environment variables
# =============================================================================
# Copy this file to .env.local for local dev. In Coolify, set the same keys
# in the application's "Environment" tab. Defaults below assume the local
# docker-compose stack (`pnpm db:up`).
# =============================================================================

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development
# Optional extra hosts to append to the Content-Security-Policy connect/img/etc.
# allow-lists (comma-separated), read in src/lib/security/headers.ts. Use when an
# added third-party (analytics, chat widget, embed) is otherwise blocked by CSP.
# The CSP is compiled at `next build` — in Docker/Coolify this is a BUILD
# argument (Dockerfile ARG); changing it needs a rebuild, not a restart.
# CSP_EXTRA_HOSTS=https://plausible.example.com,https://widget.example.com
# Optional build identifier surfaced on the Infrastructure → Performance tab
# (src/lib/telemetry/runtime-metrics.ts). Set it to the git SHA at build time.
# NEXT_PUBLIC_BUILD_SHA=

# --- Database (Postgres) ------------------------------------------------------
# docker-compose.dev.yml defaults — override in Coolify with the provisioned DB
DATABASE_URL=postgresql://tokyo:tokyo_dev_pwd@localhost:5434/tokyo
# Optional DIRECT Postgres URL for the migrator + secret bootstrap
# (src/lib/db/migrate.ts, init-secrets.ts); blank ⇒ DATABASE_URL. Set it when
# DATABASE_URL goes through the PgBouncer transaction pooler (e.g. the dev
# `pooler` profile on 6432): migrations need a direct connection (session
# advisory lock, per-session timeouts).
# MIGRATION_DATABASE_URL=postgresql://tokyo:tokyo_dev_pwd@localhost:5434/tokyo
# Optional CA bundle for VERIFIED Postgres TLS (only used when DATABASE_URL has
# sslmode=require / verify-ca / verify-full). Accepts EITHER the literal PEM
# contents OR a path to a .pem file. require + no CA = encrypted but NOT
# verified; verify-* refuse to start without a usable CA. Unset locally — see
# src/lib/db/ssl.ts.
DB_SSL_CA=
# Optional pool / observability tunables, read DIRECTLY from process.env in
# src/lib/db/client.ts (not via the env.ts schema). Defaults apply if unset:
# pool max = 12 in prod / 5 in dev; statement timeout = 10000 ms; idle timeout
# 15000 ms; acquire (connection) timeout 3000 ms; TCP keepalive ON; app name
# tags pg_stat_activity. Override only when load-tuning (e.g. bump POOL_MAX to
# 25-50 behind PgBouncer).
# DB_POOL_MAX=12
# DB_STATEMENT_TIMEOUT_MS=10000
# DB_IDLE_TIMEOUT_MS=15000
# DB_CONNECTION_TIMEOUT_MS=3000
# DB_KEEPALIVE=true
DB_APPLICATION_NAME=tokyostore-app

# --- Auth (Better Auth) -------------------------------------------------------
# BETTER_AUTH_SECRET signs session tokens. Behaviour:
#   - In Coolify / Docker: LEAVE EMPTY. The container entrypoint auto-generates
#     one on first boot and persists it to the `app_secrets` table — it
#     survives redeploys.
#   - For local dev: any 32+ char string works. Generate one with:
#     openssl rand -base64 32
# The placeholder below is intentionally REJECTED by the production secret
# guard (src/lib/env.ts → isPlaceholderSecret) so a copy-paste-and-deploy
# fails fast instead of signing every session token with this public,
# repo-known constant.
BETTER_AUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
BETTER_AUTH_URL=http://localhost:3000
# Optional CSV of EXTRA trusted origins for CSRF / cookie checks. BETTER_AUTH_URL
# is always trusted; add entries only when serving from a second hostname
# (e.g. www + apex). Read directly from process.env (not the env.ts schema) in
# src/lib/auth. Localhost is implicitly trusted in dev, so leave UNSET locally.
# BETTER_AUTH_TRUSTED_ORIGINS=https://www.tokyostore.com,https://tokyostore.com

# --- Social login (optional) ----------------------------------------------------
# Google / Facebook OAuth. Credentials are normally entered in the admin panel
# (Admin → Clients → Connexion & comptes), stored ENCRYPTED at rest. These env
# vars are an OPTIONAL override: when set they FORCE-OVERRIDE the admin value
# and lock the field (same precedence as the payment gateways). A provider is
# registered only when BOTH its id and secret resolve (env or admin); the
# storefront buttons are then toggled per provider on the same admin page.
# Callback URLs to whitelist in each provider console:
# <NEXT_PUBLIC_SITE_URL>/api/auth/callback/google (resp. /facebook).
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
# FACEBOOK_CLIENT_ID=1234567890
# FACEBOOK_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Payment gateways (Tunisia) ----------------------------------------------
# Both are optional — set only the ones you use; a provider with missing
# creds returns a clear "non configuré" error instead of failing the boot.
# *_TEST_MODE defaults to sandbox; set to "false" only for production keys.
# Amounts are sent in millimes — already the app's internal integer unit
# (1 TND = 1000; see src/lib/price.ts), so no scaling happens at the gateway.
# Credentials are ALSO editable in Admin → Système → Paiement (stored encrypted);
# any value set HERE force-overrides the admin value. PAYMENT_ENCRYPTION_KEY
# encrypts the admin-stored secrets at rest — it is AUTO-GENERATED on first
# deploy and persisted in `app_secrets` (same mechanism as BETTER_AUTH_SECRET),
# so leave it blank unless you want to supply/rotate it yourself
# (openssl rand -base64 32). Do NOT change it once secrets are stored — a new
# key makes existing encrypted credentials unreadable.
PAYMENT_ENCRYPTION_KEY=
# ClicToPay / Monétique Tunisie (SMT) — test.clictopay.com / ipay.clictopay.com
CLICTOPAY_USERNAME=
CLICTOPAY_PASSWORD=
CLICTOPAY_TEST_MODE=true
# Flouci — https://developers.flouci.com
FLOUCI_APP_TOKEN=
FLOUCI_APP_SECRET=
FLOUCI_TEST_MODE=true

# ── AI & Automation provider keys ────────────────────────────────────────────
# Also editable in Admin → Système → AI & Automation (stored encrypted in
# `ai_provider_settings`, at rest under the same PAYMENT_ENCRYPTION_KEY). Any
# value set HERE force-overrides the admin value (blank = unset). All future
# AI/automation features resolve credentials through src/lib/ai/config.ts.
#
# SEMANTIC SEARCH (embeddings): reuses these SAME provider keys — only OpenRouter
# or OpenAI can embed (Anthropic/DeepSeek cannot). Pick the provider + 1536-dim
# model in Admin → Système → IA, then vectorise the catalogue in Système →
# Recherche → Sémantique. Semantic search is OFF by default and a no-op until a
# provider is set AND the catalogue is vectorised — see docs/database.md (0112).
# It also REQUIRES the pgvector Postgres image (docker/pgvector/Dockerfile).
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default admin account: on first boot, the app creates the DEFAULT_ADMIN_EMAIL
# below (default houssem@kawn.me) with a random password and prints it to the
# container log. Sign in, change email/password via /account, you're done — no
# curl ceremony needed. Seed it at your OWN real, receivable address so the
# password-reset / email-change confirmation actually reaches you.
DEFAULT_ADMIN_EMAIL=houssem@kawn.me
# To opt out (and use the bootstrap-token path below instead):
#   DISABLE_DEFAULT_ADMIN=true
DISABLE_DEFAULT_ADMIN=

# Fallback bootstrap path. Same auto-generation behaviour as BETTER_AUTH_SECRET:
# leave UNSET in Coolify and the entrypoint will generate + persist + echo the
# value to the container log. Only needed if you opt out of the default admin
# OR the auto-creation fails. Unset after bootstrap to disable the endpoint.
ADMIN_BOOTSTRAP_TOKEN=dev_bootstrap_token_replace_in_prod_min_8_chars

# Staff/admin login URL. The staff sign-in page (separate from the customer
# /login) lives at /admin-login by default. Set a SECRET path here (e.g.
# /staff-x7k2) to expose it only there — proxy.ts rewrites the secret path to
# the real route and 404s the /admin-login default. When a secret path is set,
# an unauthenticated /admin returns 404 (NOT a redirect — a redirect would leak
# the secret slug); staff use the secret path directly. With the default
# /admin-login, /admin redirects there. Must be a clean absolute path ("/...")
# or it's ignored.
ADMIN_LOGIN_PATH=

# Shared secret for the scheduled data-retention purge (POST /api/cron/retention,
# called daily by a Coolify scheduled job — see docs/deployment-coolify.md §12).
# Leave UNSET locally: the route returns 503 (purge disabled) until it's set.
# In prod set a long random value: `openssl rand -hex 32`. Min 16 chars.
CRON_SECRET=

# Optional defence-in-depth: comma-separated allowlist of client IPs permitted
# to call /api/cron/* (checked BEFORE the CRON_SECRET compare). When set, a
# request from any other IP is refused 403 even with a valid secret — so a
# leaked token alone can't trigger the jobs. Leave UNSET to allow all (default,
# backward-compatible). Example: CRON_ALLOWED_IPS=203.0.113.10,203.0.113.11
CRON_ALLOWED_IPS=

# Optional cron-workflow tunables, read DIRECTLY from process.env (not env.ts).
# Defaults apply if unset:
#  - ABANDONED_ORDER_HOURS: EVERY order still `pending` after this many hours —
#    COD awaiting confirmation included, not only unpaid gateway orders — is
#    cancelled (reserved stock released) by /api/cron/abandoned-orders
#    (default 48).
#  - PAYMENT_RECONCILE_STALE_MINUTES: a pending gateway payment idle this long is
#    re-verified by /api/cron/payments (default 20).
#  - PAYMENT_RECONCILE_MAX_AGE_HOURS: stop re-verifying a pending payment older
#    than this (default 24).
# Keep the abandon window BEYOND the reconcile window.
# ABANDONED_ORDER_HOURS=48
# PAYMENT_RECONCILE_STALE_MINUTES=20
# PAYMENT_RECONCILE_MAX_AGE_HOURS=24

# --- Email --------------------------------------------------------------------
# EMAIL_PROVIDER picks the active provider: "resend" | "smtp" | "internal" | "console"
# - resend   → uses RESEND_API_KEY
# - smtp     → uses SMTP_* vars below
# - internal → local sendmail binary (SENDMAIL_PATH below)
# - console  → logs emails to stdout (dev default — no credentials needed)
EMAIL_PROVIDER=console
EMAIL_FROM="Tokyo Store <noreply@tokyostore.com>"
EMAIL_REPLY_TO=support@tokyostore.com

RESEND_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Local sendmail binary for the "internal" provider (EMAIL_PROVIDER=internal).
# Overrides the admin mail.sendmail_path setting when set; leave unset to use
# the platform default (/usr/sbin/sendmail). See src/lib/email/config.ts.
SENDMAIL_PATH=

# --- Storage (SeaweedFS / S3-compatible) --------------------------------------
# Defaults assume the local SeaweedFS S3 gateway (docker-compose.dev.yml, :8333);
# override for the Coolify-managed SeaweedFS. In prod, set S3_ACCESS_KEY /
# S3_SECRET_KEY to real generated values — the admin Sécurité page flags the dev
# placeholders below. The seaweedfs service builds its identities config from the
# SAME two keys, so the app (writer) and the store always agree.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=tokyo
S3_ACCESS_KEY=seaweedfs
S3_SECRET_KEY=seaweedfs_dev_secret
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:8333/tokyo

# Optional CDN base FALLBACK for public media URLs (comma-separated; first
# entry used). Precedence: media_settings.cdn_base_url (admin-editable DB
# field, primary) → MEDIA_CDN_URL → same-origin /cdn proxy. Keep any host you
# set here in sync with the admin cdn_base_url so next/image + the CSP
# allow-list it — next.config compiles this at `next build` (a Docker BUILD
# argument: changing it needs a rebuild). A CDN base outside the build's list is
# ignored at runtime (falls back to /cdn). See src/modules/media/cdn-base.ts.
MEDIA_CDN_URL=

# --- Misc tunables ------------------------------------------------------------
# AI review-draft scheduler tick interval in ms. Read directly from process.env
# in src/workflows/catalog/review-gen/scheduler.ts; blank ⇒ 30 min (1800000).
# REVIEW_SCHEDULER_TICK_MS=1800000
