# =============================================================================
# Coolify deployment — example .env
# =============================================================================
# In Coolify: paste docker-compose.coolify.yml as a Docker Compose resource.
# Coolify will SHOW these vars as form fields and auto-generate the
# SERVICE_PASSWORD_* values. You only need to fill in the things below
# marked "you fill this in".
#
# For routine LOCAL development use `docker compose -f docker-compose.dev.yml up`
# instead — that stack is built for it. This compose hardcodes NODE_ENV=production,
# so the prod-secret guard (src/lib/env.ts) rejects dev placeholders on boot: to run
# THIS file locally, copy it to `.env` next to the compose AND replace the placeholder
# SERVICE_USER_SEAWEEDFS (not "seaweedfs") and set PUBLIC_URL to an https origin.
# On a real Coolify deploy both happen automatically (random service creds + your
# https domain), so no change is needed there.
# =============================================================================

# --- Public URL — what users hit in the browser --------------------------------
# Coolify: when you add a custom domain (e.g. setup.tokyostore.com) in the
#   app service settings, set this to that URL.
# Local:   leave as-is.
#
# IMPORTANT: also paste this same value into Coolify's "Build Arguments"
# tab as `NEXT_PUBLIC_SITE_URL`. Build args are baked into the JS bundle
# at `next build` time — runtime env changes alone won't update them.
# Optionally also set NEXT_PUBLIC_BUILD_SHA (build arg) to the git SHA so the
# Infrastructure → Performance tab can show which build is live.
PUBLIC_URL=http://localhost:3000

# Extra CSV of origins Better Auth should trust for CSRF + cookie checks.
# `PUBLIC_URL` is always trusted automatically. Add an entry here ONLY if
# you serve the app from a second hostname (e.g. www. + apex).
# BETTER_AUTH_TRUSTED_ORIGINS=https://www.tokyostore.com,https://tokyostore.com

# --- Admin / access control ----------------------------------------------------
# Secret staff-login path (e.g. /staff-x7k2). When set, the staff sign-in lives
# ONLY there; the /admin-login default 404s and an unauthenticated /admin 404s
# (not a redirect — that would leak the slug). Clean absolute path or it's
# ignored. Leave blank to keep the default /admin-login.
# ADMIN_LOGIN_PATH=/staff-x7k2
#
# true ⇒ skip the first-boot auto-creation of admin@tokyostore.com.
# DISABLE_DEFAULT_ADMIN=true
#
# Bearer token enabling the daily data-retention purge (POST /api/cron/retention,
# wired as a Coolify Scheduled Task — see docs/deployment-coolify.md §12). Blank
# ⇒ purge disabled (route returns 503). Min 16 chars: openssl rand -hex 32.
# CRON_SECRET=
# Optional IP allowlist for /api/cron/* (comma-separated). When set, a request
# whose source IP is not listed is refused 403 BEFORE the secret compare — a
# leaked CRON_SECRET alone then can't trigger the jobs. Unset = allow all.
# CRON_ALLOWED_IPS=
# Optional cron-workflow tunables (defaults if blank):
#  - ABANDONED_ORDER_HOURS (48): EVERY order still `pending` — COD awaiting
#    confirmation included, not just unpaid gateway orders — is cancelled (and
#    its reserved stock released) after this many hours.
#  - PAYMENT_RECONCILE_STALE_MINUTES (20): a pending gateway payment idle this
#    long is re-verified with the gateway;
#  - PAYMENT_RECONCILE_MAX_AGE_HOURS (24): …until it is this old.
# Keep the abandon window BEYOND the reconcile window.
# ABANDONED_ORDER_HOURS=48
# PAYMENT_RECONCILE_STALE_MINUTES=20
# PAYMENT_RECONCILE_MAX_AGE_HOURS=24
# Optional extra CSP hosts (comma-separated) if you add a third-party
# analytics/chat/embed that CSP would otherwise block (src/lib/security/headers.ts).
# The CSP is compiled at BUILD time: the compose passes this as a build argument
# too, so changing it needs a REBUILD (redeploy), not just a restart.
# CSP_EXTRA_HOSTS=
# Google / Facebook OAuth. Enter credentials in the admin panel (Admin → Système
# → Connexion & comptes), stored ENCRYPTED at rest. These env vars are an
# OPTIONAL override that FORCE-OVERRIDES + locks the admin field (same precedence
# as the payment gateways). A provider is registered only when BOTH its id and
# secret resolve (env or admin); the buttons are then toggled per provider on the
# same page. Whitelist the callback URL
# <PUBLIC_URL>/api/auth/callback/google (resp. /facebook) in each console.
# (The compose passes these through; blank = use the admin value.)
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
# FACEBOOK_CLIENT_ID=1234567890
# FACEBOOK_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Postgres ------------------------------------------------------------------
# Coolify auto-generates SERVICE_PASSWORD_POSTGRES — you don't set it.
# Local: pick anything strong.
SERVICE_PASSWORD_POSTGRES=local_dev_postgres_password_change_in_prod
POSTGRES_USER=tokyo
POSTGRES_DB=tokyo

# The compose wires DATABASE_URL (runtime) and MIGRATION_DATABASE_URL (boot
# migrator + secret bootstrap) to the internal postgres:5432 — nothing to set.
# When you enable the PgBouncer `pooler` profile, move ONLY DATABASE_URL to
# pgbouncer:5432 (edit the compose); MIGRATION_DATABASE_URL must stay DIRECT.

# Optional Postgres pool / observability tunables (defaults apply if blank).
# Behind PgBouncer, bump DB_POOL_MAX to 25-50 (client-side cap multiplexed onto
# a smaller server pool). Idle 15000 ms / acquire 3000 ms / keepalive ON.
# DB_POOL_MAX=12
# DB_STATEMENT_TIMEOUT_MS=10000
# DB_IDLE_TIMEOUT_MS=15000
# DB_CONNECTION_TIMEOUT_MS=3000
# DB_KEEPALIVE=true
# DB_APPLICATION_NAME=tokyostore-app

# Optional CA bundle for VERIFIED Postgres TLS — only relevant when a
# DATABASE_URL carries sslmode=require / verify-ca / verify-full (e.g. an
# external/managed DB). Accepts either the literal PEM contents OR a path to a
# .pem file inside the container. The compose's internal postgres:5432 URL is
# plain (private network), so leave unset there. With sslmode=require and no
# CA the link is encrypted but NOT verified; verify-* REFUSE to start without a
# usable CA. See src/lib/db/ssl.ts.
# DB_SSL_CA=

# --- SeaweedFS (object storage) ------------------------------------------------
# Coolify auto-generates SERVICE_PASSWORD_SEAWEEDFS and SERVICE_USER_SEAWEEDFS.
# These are the S3 access/secret keys: the seaweedfs service builds its
# identities config from them AND the app signs its uploads with them.
# Local: pick anything strong.
SERVICE_USER_SEAWEEDFS=seaweedfs
SERVICE_PASSWORD_SEAWEEDFS=local_dev_seaweedfs_password_change_in_prod
S3_BUCKET=tokyo

# Browser-reachable URL for uploaded images — ONLY needed if you serve media
# from a dedicated object-store domain instead of the default same-origin /cdn
# proxy (which needs no public host). Leave the default unless you do.
# Coolify: set this to https://s3.tokyostore.com (a custom domain on the
#   seaweedfs service, port 8333). The bucket suffix is added by the compose.
#
# IMPORTANT: this value (with the /${S3_BUCKET} suffix) ALSO must be set as the
# `S3_PUBLIC_URL` build arg in Coolify → Build Arguments. Without it, Next.js's
# images.remotePatterns + CSP img-src won't include the object-store host and
# a directly-linked image 400s with "hostname not configured".
SEAWEEDFS_PUBLIC_URL=http://localhost:8333

# Optional CDN base FALLBACK for public media URLs (comma-separated; first
# entry used). Precedence: media_settings.cdn_base_url (admin-editable DB
# field, primary) → MEDIA_CDN_URL → same-origin /cdn proxy. Any CDN host an
# admin points cdn_base_url at must be listed here. next/image + the CSP
# allow-list it at BUILD time — the compose passes this as a build argument, so
# adding/changing a host needs a REBUILD (redeploy); a restart is not enough. A
# host the build didn't include is ignored at runtime (media keep being served
# through /cdn) and Admin → Médias → Réglages warns about it.
# MEDIA_CDN_URL=https://cdn.tokyostore.com

# Optional: AI review-draft scheduler tick interval in ms (blank ⇒ 30 min).
# REVIEW_SCHEDULER_TICK_MS=1800000

# --- Email (you fill this in) --------------------------------------------------
# Pick ONE provider. console = log to stdout, useful for staging.

EMAIL_PROVIDER=console
EMAIL_FROM=Tokyo Store <noreply@tokyostore.com>
EMAIL_REPLY_TO=support@tokyostore.com

# Resend:
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMTP:
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=your-username
# SMTP_PASSWORD=your-password
# SMTP_SECURE=false

# Internal (local sendmail binary):
# EMAIL_PROVIDER=internal
# SENDMAIL_PATH overrides the admin mail.sendmail_path setting; leave unset to
# use the platform default (/usr/sbin/sendmail). Only relevant when the image
# actually ships a sendmail-compatible binary.
# SENDMAIL_PATH=/usr/sbin/sendmail

# --- Payment gateways (optional) ------------------------------------------------
# ClicToPay / Flouci credentials are entered after deploy in
# Admin → Système → Paiement (stored encrypted in the DB). This compose does
# not pass gateway env vars to the app container; to use the env-override
# route instead (CLICTOPAY_*, FLOUCI_* — see .env.example), add
# those keys to the app service's `environment:` block first.
